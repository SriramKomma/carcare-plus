# Maven build output
target/

# Crawled data: large and regenerated by the crawler (keep the folders via .gitkeep)
data/raw-pages/*
!data/raw-pages/.gitkeep
data/parsed-pages/*
!data/parsed-pages/.gitkeep
data/search-history.txt

# IDE files (Eclipse, IntelliJ, VS Code workspace state)
.classpath
.project
.settings/
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# macOS
.DS_Store

# Logs
*.log

# OpenStreetMap downloads (ODbL data, regenerated with the osm command)
data/osm/
